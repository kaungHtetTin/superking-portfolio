<?php
// Local recovery tool. Password is read from stdin, never from command arguments.
require dirname(__DIR__).'/bootstrap/app.php';
$email=$argv[1]??'';
if(!filter_var($email,FILTER_VALIDATE_EMAIL)){fwrite(STDERR,"Usage: php bin/admin-password email@example.com\nThen enter a new password on stdin.\n");exit(1);}
$password=trim(fgets(STDIN)?:'');
if(strlen($password)<12){fwrite(STDERR,"Password must have at least 12 characters.\n");exit(1);}
$admin=Mini\Database::fetch('SELECT id FROM admins WHERE email=?',[$email]);
if($admin)Mini\Database::update('admins',(int)$admin['id'],['password'=>password_hash($password,PASSWORD_DEFAULT)]);
else Mini\Database::insert('admins',['email'=>$email,'password'=>password_hash($password,PASSWORD_DEFAULT)]);
echo "Admin account saved.\n";
